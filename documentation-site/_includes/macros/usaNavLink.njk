{% macro link(href, title, pageUrl) %}
  {% set isExternal = href.includes("http") %}
  {% set isCurrentPage = (href == pageUrl) %}
  <a href="{{ href }}" class="usa-nav-link{% if isCurrentPage %} usa-current{% endif %}{% if isExternal %} modern-external-link{% endif %}" {% if isCurrentPage %} aria-current="page" {% endif %} {% if isExternal %} rel="noreferrer" target="_blank" {% endif %}>{{ title }}</a>
{% endmacro %}
---
layout: "/layouts/base.njk"
---

<div class="grid-left-column">
  {% include "../components/side-navigation.njk" %}
</div>
<main id="main-content" class="grid-center-column">
  <div class="usa-prose">
    <h1>{{ title | safe }}</h1>
    <p class="reference-links">
      {% if storybook_url %}
        <a href="{{ storybook_url }}" class="usa-link usa-link--external">Storybook</a>
      {% endif %}
      {% if accessibility_tests_url %}
        <a href="{{ accessibility_tests_url }}" class="usa-link usa-link--external">Accessibility checklists</a>
      {% endif %}
      {% if background_research_url %}
        <a href="{{ background_research_url }}" class="usa-link usa-link--external">Background research</a>
      {% endif %}
    </p>
    <p>{{ description | safe }}</p>
    {{ content | safe }}
  </div>
</main>
<div class="grid-right-column">
  {% include "../components/in-page-navigation.njk" %}
</div>
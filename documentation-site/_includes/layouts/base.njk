<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width,initial-scale=1"/>
    <meta http-equiv="content-type" content="text/html; charset=UTF-8"/>
    <script webc:keep type="module" src="/assets/js/elements.js"></script>
    <link webc:keep rel="stylesheet" href="/assets/css/uswds.min.css"/>
    <link webc:keep rel="stylesheet" href="/assets/css/styles.css"/>
    <link webc:keep rel="stylesheet" href="/assets/css/prism-one-light.css"/>
    <title>{{ title }}</title>
  </head>
  <body class="display-flex flex-column minh-viewport">
    <div class="grid-wrapper">
      <a class="usa-skipnav" href="#main-content">Skip to main content</a>
      <div class="usa-overlay"></div>
      <div class="grid-row-header">
        {% include "../components/header.njk" %}
      </div>
      {{ content | safe }}
      <div class="grid-row-pre-footer">
        <div class="usa-footer__return-to-top">
          <a href="#top" class="usa-link">Return to top</a>
        </div>
      </div>
      <footer class="grid-row-footer grid-row-full-width simple-footer">
        {% include "../components/footer.njk" %}
      </footer>
    </div>
  </body>
  <script webc:keep src="/assets/js/uswds.min.js"></script>
</html>
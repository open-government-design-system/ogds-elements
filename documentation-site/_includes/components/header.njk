{% macro usaNavLink(href, name) %}
  <a href="{{ href }}" class="usa-nav-link{% if href == page.url %} usa-current{% endif %}">
    <span>{{ name }}</span>
  </a>
{% endmacro %}
{% macro usaNavLinkExternal(href, name) %}
  <a href="{{ href }}" class="usa-nav-link usa-link--external">
    <span>{{ name }}</span>
  </a>
{% endmacro %}
<div class="usa-overlay"></div>
<header class="usa-header usa-header--basic">
  <div class="usa-nav-container">
    <div class="usa-navbar">
      <div class="usa-logo">
        <em class="usa-logo__text">
          <a href="/">Open Government Design System</a>
        </em>
      </div>
      <button type="button" class="usa-menu-btn">Menu</button>
    </div>
    <nav aria-label="Primary navigation" class="usa-nav">
      <button type="button" class="usa-nav__close">
        <img src="/assets/img/usa-icons/close.svg" role="img" alt="Close"/>
      </button>
      <ul class="usa-nav__primary usa-accordion">
        <li class="usa-nav__primary-item">
          {{ usaNavLink("/about/", "About OGDS") }}
        </li>
        <li class="usa-nav__primary-item">
          {{ usaNavLink("/elements/", "OGDS Elements") }}
        </li>
        <li class="usa-nav__primary-item">
          {{ usaNavLinkExternal("https://docs.google.com/document/d/10XN6ZsRt9aAOH1PUmtfcCCEBZQUSgs1cCI5krYBOoi4/edit?tab=t.0", "Join the effort") }}
        </li>
        <li class="usa-nav__primary-item">
          {{ usaNavLinkExternal("https://docs.google.com/document/d/1TXmD5nLmANcOlF9ipR7wnY06iuFj6zTEYaGiZ-2X3Ug/edit?tab=t.0#heading=h.pctub6czqxup", "Code of Conduct") }}
        </li>
      </ul>
    </nav>
  </div>
</header>